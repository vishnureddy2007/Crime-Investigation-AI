# ---- Things the Docker image does NOT need ------------------------

# Python
__pycache__/
*.py[cod]
*.so
.Python
*.egg-info/
*.egg
build/
dist/

# Virtual envs (rebuilt inside the image)
venv/
.venv/
env/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Git / CI
.git/
.gitignore
.github/

# Tests + coverage (the test job runs in CI, not in the image)
.pytest_cache/
.coverage
htmlcov/

# Generated artefacts (regenerated by the app, not needed at build)
outputs/reports/*.pdf
outputs/reports/*.docx
outputs/videos/*.mp4
outputs/storyboard/*.png
outputs/storyboard/*.jpg
outputs/storyboard/*.jpeg

# Local SQLite DB (regenerated inside the container if needed)
database/*.db
database/*.sqlite
database/*.sqlite3

# Streamlit secrets
.streamlit/secrets.toml

# Logs
*.log
logs/

# Env files
.env
.env.local
