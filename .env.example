# =================================================================
# AI-Based Crime Investigation Assistant - environment variables
# =================================================================
# Copy this file to `.env` and adjust values. Every key is OPTIONAL -
# the app runs with sensible defaults if a key is missing.
#
# On Windows:     copy .env.example .env
# On macOS/Linux: cp    .env.example .env
# =================================================================

# ---- Streamlit server ---------------------------------------------
APP_PORT=8501
APP_ADDRESS=localhost
# Run Streamlit in headless mode (no browser auto-launch). Set to
# `true` when running inside Docker or a remote VM.
APP_HEADLESS=false

# ---- UI Theme -----------------------------------------------------
# One of `light` or `dark`. Used by app.py to pick the CSS injected
# into the Streamlit page. The Settings page lets users override
# this at runtime.
APP_THEME=light

# ---- HuggingFace model cache --------------------------------------
# Where FLAN-T5 (and other transformers) keep downloaded weights.
# Defaults to ~/.cache/huggingface if unset.
HF_HOME=%USERPROFILE%\\.cache\\huggingface

# ---- Logging ------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
